generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// TENANT
// ═══════════════════════════════════════════

model School {
  id        String   @id @default(cuid())
  name      String   @db.NVarChar(200)
  slug      String   @unique @db.NVarChar(50)
  logoUrl   String?  @db.NVarChar(Max)
  address   String?  @db.NVarChar(Max)
  phone     String?  @db.NVarChar(20)
  email     String?  @db.NVarChar(255)
  plan      String   @default("BASIC") @db.NVarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolUsers   SchoolUser[]
  academicYears AcademicYear[]
  classes       Class[]
  students      Student[]
  teachers      Teacher[]
  parents       Parent[]
  documents     Document[]
  feeStructures FeeStructure[]
  subjects      Subject[]

  @@map("schools")
}

// ═══════════════════════════════════════════
// AUTH & RBAC
// ═══════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.NVarChar(255)
  passwordHash String   @db.NVarChar(255)
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolUsers SchoolUser[]
  student     Student?
  teacher     Teacher?
  parent      Parent?

  @@map("users")
}

model SchoolUser {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  role      String   @db.NVarChar(20) // ADMIN | TEACHER | STUDENT | PARENT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    school School @relation(fields: [schoolId], references: [id], onDelete: NoAction)

  @@unique([userId, schoolId, role])
  @@map("school_users")
}

// ═══════════════════════════════════════════
// ACADEMIC STRUCTURE
// ═══════════════════════════════════════════

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.NVarChar(20)
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  school      School              @relation(fields: [schoolId], references: [id], onDelete: NoAction)
  classes     Class[]
  enrollments StudentEnrollment[]
  feeStructures FeeStructure[]

  @@unique([name, schoolId])
  @@map("academic_years")
}

model Class {
  id             String   @id @default(cuid())
  schoolId       String
  name           String   @db.NVarChar(50)
  gradeLevel     String   @db.NVarChar(20)
  capacity       Int      @default(40)
  academicYearId String
  classTeacherId String?
  createdAt      DateTime @default(now())

  school        School              @relation(fields: [schoolId], references: [id], onDelete: NoAction)
  academicYear  AcademicYear        @relation(fields: [academicYearId], references: [id])
  classTeacher  Teacher?            @relation(fields: [classTeacherId], references: [id])
  enrollments   StudentEnrollment[]
  assessments   Assessment[]

  @@unique([name, academicYearId, schoolId])
  @@map("classes")
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  name        String   @db.NVarChar(100)
  code        String   @db.NVarChar(20)
  description String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: NoAction)
  assessments Assessment[]

  @@unique([code, schoolId])
  @@map("subjects")
}

// ═══════════════════════════════════════════
// PEOPLE
// ═══════════════════════════════════════════

model Student {
  id              String   @id @default(cuid())
  schoolId        String
  userId          String?  @unique
  admissionNumber String   @db.NVarChar(20)
  firstName       String   @db.NVarChar(100)
  lastName        String   @db.NVarChar(100)
  dateOfBirth     DateTime
  gender          String   @db.NVarChar(10)
  enrollmentDate  DateTime
  status          String   @default("ACTIVE") @db.NVarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school      School              @relation(fields: [schoolId], references: [id], onDelete: NoAction)
  user        User?               @relation(fields: [userId], references: [id])
  enrollments StudentEnrollment[]
  parentLinks StudentParent[]
  documents   Document[]
  grades      Grade[]
  feeRecords  FeeRecord[]

  @@unique([admissionNumber, schoolId])
  @@map("students")
}

model StudentEnrollment {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  classId        String
  academicYearId String
  enrolledAt     DateTime @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction)
  class        Class        @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("student_enrollments")
}

model Teacher {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String   @unique
  staffNumber String   @db.NVarChar(20)
  firstName   String   @db.NVarChar(100)
  lastName    String   @db.NVarChar(100)
  phone       String?  @db.NVarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction)
  classes Class[]

  @@unique([staffNumber, schoolId])
  @@map("teachers")
}

model Parent {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?  @unique
  firstName String   @db.NVarChar(100)
  lastName  String   @db.NVarChar(100)
  phone     String   @db.NVarChar(20)
  email     String?  @db.NVarChar(255)
  createdAt DateTime @default(now())

  school       School          @relation(fields: [schoolId], references: [id], onDelete: NoAction)
  user         User?           @relation(fields: [userId], references: [id])
  studentLinks StudentParent[]

  @@map("parents")
}

model StudentParent {
  studentId    String
  parentId     String
  relationship String   @db.NVarChar(50)
  isPrimary    Boolean  @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: NoAction)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: NoAction)

  @@id([studentId, parentId])
  @@map("student_parents")
}

// ═══════════════════════════════════════════
// DOCUMENTS
// ═══════════════════════════════════════════

model Document {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  documentType String    @db.NVarChar(50)
  fileName     String    @db.NVarChar(255)
  filePath     String    @db.NVarChar(Max)
  fileSize     Int?
  mimeType     String?   @db.NVarChar(100)
  capturedAt   DateTime?
  odbcMetadata String?   @db.NVarChar(Max)
  createdAt    DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: NoAction)
  student Student @relation(fields: [studentId], references: [id], onDelete: NoAction)

  @@map("documents")
}

// ═══════════════════════════════════════════
// GRADING
// ═══════════════════════════════════════════

model Assessment {
  id             String   @id @default(cuid())
  schoolId       String
  classId        String
  subjectId      String
  title          String   @db.NVarChar(200)
  type           String   @db.NVarChar(50)  // EXAM | CAT | ASSIGNMENT | PROJECT
  maxScore       Decimal  @db.Decimal(6, 2)
  weight         Decimal  @db.Decimal(5, 2) // percentage weight in final grade
  assessmentDate DateTime
  createdAt      DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  grades  Grade[]

  @@map("assessments")
}

model Grade {
  id           String   @id @default(cuid())
  studentId    String
  assessmentId String
  score        Decimal  @db.Decimal(6, 2)
  remarks      String?  @db.NVarChar(Max)
  gradedAt     DateTime @default(now())

  student    Student    @relation(fields: [studentId], references: [id], onDelete: NoAction)
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([studentId, assessmentId])
  @@map("grades")
}

// ═══════════════════════════════════════════
// FEE MANAGEMENT
// ═══════════════════════════════════════════

model FeeStructure {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String   @db.NVarChar(100)  // "Form 1 Fees", "Grade 7 Fees"
  gradeLevel     String   @db.NVarChar(20)
  totalAmount    Decimal  @db.Decimal(12, 2)
  currency       String   @default("KES") @db.NVarChar(5)
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: NoAction)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  feeItems     FeeItem[]
  feeRecords   FeeRecord[]

  @@map("fee_structures")
}

model FeeItem {
  id             String  @id @default(cuid())
  feeStructureId String
  name           String  @db.NVarChar(100)  // "Tuition", "Boarding", "Uniform"
  amount         Decimal @db.Decimal(12, 2)
  isOptional     Boolean @default(false)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: NoAction)

  @@map("fee_items")
}

model FeeRecord {
  id             String   @id @default(cuid())
  studentId      String
  feeStructureId String
  amountDue      Decimal  @db.Decimal(12, 2)
  amountPaid     Decimal  @default(0) @db.Decimal(12, 2)
  balance        Decimal  @db.Decimal(12, 2)
  status         String   @default("UNPAID") @db.NVarChar(20) // UNPAID | PARTIAL | PAID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     FeePayment[]

  @@unique([studentId, feeStructureId])
  @@map("fee_records")
}

model FeePayment {
  id          String   @id @default(cuid())
  feeRecordId String
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @db.NVarChar(30)   // MPESA | BANK | CASH | CHEQUE
  reference   String?  @db.NVarChar(100)  // M-Pesa transaction ID
  paidAt      DateTime @default(now())
  recordedBy  String   @db.NVarChar(255)  // admin email

  feeRecord FeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: NoAction)

  @@map("fee_payments")
}